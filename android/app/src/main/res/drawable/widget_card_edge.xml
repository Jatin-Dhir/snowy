<?xml version="1.0" encoding="utf-8"?>
<!-- The card's hairline edge, so a light card still holds its shape on a light wallpaper -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- an explicit clear fill: tinted with no solid colour, a GradientDrawable paints its fill opaque -->
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/voice_edge" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
