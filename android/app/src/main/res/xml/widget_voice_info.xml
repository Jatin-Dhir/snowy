<?xml version="1.0" encoding="utf-8"?>
<!-- Three cells wide by default; shrinks to the mic alone. No timed updates:
     it only changes when the app sends a new accent. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_voice_description"
    android:initialLayout="@layout/widget_voice"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_voice"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
