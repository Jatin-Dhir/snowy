<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, two cells: [mic  +] -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_surface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/widget_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_voice_action"
            android:foreground="@drawable/widget_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/widget_mic_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_accent" />

                <ImageView
                    android:id="@+id/widget_mic_glyph"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_mic" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_add_action"
            android:foreground="@drawable/widget_ripple_disc">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_disc_button" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
