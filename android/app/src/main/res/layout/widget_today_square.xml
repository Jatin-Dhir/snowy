<?xml version="1.0" encoding="utf-8"?>
<!-- Two by two: Home's ring with Taily's cat, today's figure under it, and the two ways to log. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <ImageView
        android:id="@+id/widget_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_edge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:foreground="@drawable/widget_ripple"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/widget_ring"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_number"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/widget_setup"
                android:textColor="@color/voice_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="@color/voice_muted"
                android:textSize="12sp" />

            <!-- The month under today, as the four-by-two's month row and Home's month strip: "₹39,386 of ₹50,000"
                 over a bar of the budget spent. Only with a budget, on a widget tall enough for it (VoiceWidget's
                 SQUARE_TALL); as wide as Speak and Add below it, wider only for a long figure. Part of the figure's
                 tap, which opens Taily. The bar's fill is the share spent: its row's weightSum is 1 / that share. -->
            <LinearLayout
                android:id="@+id/widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minWidth="102dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_month_spent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/voice_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_month_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/voice_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/widget_month_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_capsule" />

                    <LinearLayout
                        android:id="@+id/widget_month_bar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <ImageView
                            android:id="@+id/widget_month_fill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_capsule" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_voice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/widget_voice_action"
                android:foreground="@drawable/widget_ripple_disc">

                <ImageView
                    android:id="@+id/widget_mic_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_accent" />

                <ImageView
                    android:id="@+id/widget_mic_glyph"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_mic" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/widget_add_action"
                android:foreground="@drawable/widget_ripple_disc">

                <ImageView
                    android:id="@+id/widget_add_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_button" />

                <ImageView
                    android:id="@+id/widget_add_glyph"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_plus" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
