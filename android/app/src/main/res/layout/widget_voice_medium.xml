<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, three cells: [mic  Speak  +] (the full label needs four).
     A widget is drawn by the launcher from RemoteViews, so only FrameLayout,
     LinearLayout, ImageView and TextView appear here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_surface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/widget_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_voice_action"
            android:foreground="@drawable/widget_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/widget_mic_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_accent" />

                <ImageView
                    android:id="@+id/widget_mic_glyph"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_mic" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_voice_short"
                android:textColor="@color/voice_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_add_action"
            android:foreground="@drawable/widget_ripple_disc">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_disc_button" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
