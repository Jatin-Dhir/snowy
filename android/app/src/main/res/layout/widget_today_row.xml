<?xml version="1.0" encoding="utf-8"?>
<!-- One row high: a capsule like the app's dock, [ring  Safe to spend today / ₹740  mic  +].
     VoiceWidget fills it in and drops what a narrow one has no room for: two cells keep the number
     and the mic, three add the +, four or more bring the ring. A widget is drawn by the launcher from
     RemoteViews, so only FrameLayout, LinearLayout, ImageView and TextView appear here; the ring and
     the number are bitmaps (WidgetArt), since a launcher can't load an app's fonts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_capsule"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_capsule" />

        <ImageView
            android:id="@+id/widget_edge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_capsule_edge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/widget_info"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:foreground="@drawable/widget_ripple_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_ring"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_title"
                        android:textColor="@color/voice_muted"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/widget_number"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_setup"
                        android:textColor="@color/voice_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_voice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/widget_voice_action"
                android:foreground="@drawable/widget_ripple_disc">

                <ImageView
                    android:id="@+id/widget_mic_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_accent" />

                <ImageView
                    android:id="@+id/widget_mic_glyph"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_mic" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/widget_add_action"
                android:foreground="@drawable/widget_ripple_disc">

                <ImageView
                    android:id="@+id/widget_add_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_disc_button" />

                <ImageView
                    android:id="@+id/widget_add_glyph"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_plus" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
