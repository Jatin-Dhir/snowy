<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one cell: the mic alone -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_voice"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_surface_round"
        android:contentDescription="@string/widget_voice_action"
        android:foreground="@drawable/widget_ripple_disc">

        <ImageView
            android:id="@+id/widget_mic_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_disc_accent" />

        <ImageView
            android:id="@+id/widget_mic_glyph"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mic" />
    </FrameLayout>
</FrameLayout>
