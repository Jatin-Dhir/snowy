<?xml version="1.0" encoding="utf-8"?>
<!-- One cell: the mic alone, on a round piece of Taily's surface -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_oval"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_oval" />

        <ImageView
            android:id="@+id/widget_edge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_oval_edge" />

        <FrameLayout
            android:id="@+id/widget_voice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_voice_action"
            android:foreground="@drawable/widget_ripple_disc">

            <ImageView
                android:id="@+id/widget_mic_bg"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_disc_accent" />

            <ImageView
                android:id="@+id/widget_mic_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
